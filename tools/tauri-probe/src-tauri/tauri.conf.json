{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Ark probe",
	"version": "0.0.0",
	"identifier": "org.polyzon.ark.probe",
	"build": {
		"frontendDist": "../dist",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Polyzon Ark — проверка оболочки",
				"width": 1280,
				"height": 800,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
